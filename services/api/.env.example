# Local: copy to .env (never commit .env)
# Railway: set variables in the service tab.
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# Auth — generate a long random string for production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Use the Web client ID plus iOS/Android client IDs, comma-separated (used to verify ID tokens).
# Same three IDs as Expo (Web + iOS + Android OAuth clients), comma-separated, no spaces
GOOGLE_CLIENT_IDS=559395124998-80nodpvoat8ifi2f1qm9qc2f2cdngd22.apps.googleusercontent.com,559395124998-j0k515p1mjrrhkljm18te9k7ui8htc40.apps.googleusercontent.com,559395124998-1s4vnrk1jcp3ii42o669udllcfa1iqt4.apps.googleusercontent.com
