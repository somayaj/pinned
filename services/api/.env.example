# Local: copy to .env (never commit .env)
# Railway: set variables in the service tab.
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# Auth — generate a long random string for production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Use the Web client ID plus iOS/Android client IDs, comma-separated (used to verify ID tokens).
GOOGLE_CLIENT_IDS=your-web.apps.googleusercontent.com,your-ios.apps.googleusercontent.com,your-android.apps.googleusercontent.com
