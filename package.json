{
  "name": "pinned",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "mobile": "npm run start -w pinned-mobile",
    "api": "npm run dev -w pinned-api",
    "dev": "concurrently -n api,mobile -c blue,green \"npm run api\" \"npm run mobile\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
